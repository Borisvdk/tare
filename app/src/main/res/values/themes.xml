<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tare" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tare_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Tare.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tare_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.Tare</item>
    </style>
</resources>
