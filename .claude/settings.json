{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "MSYS_NO_PATHCONV": "1"
  },
  "permissions": {
    "allow": [
      "Bash(scripts/dev.sh:*)",
      "Bash(./gradlew:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(gh pr:*)",
      "Bash(gh run:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(python tools/generic-foods/build.py:*)"
    ]
  }
}
